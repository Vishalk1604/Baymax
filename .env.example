# Copy this file to `.env` (gitignored) and fill in your values.
# They are compiled into the app at build time and read in lib/config/app_config.dart:
#
#   flutter run --release --dart-define-from-file=.env
#   flutter build apk --release --dart-define-from-file=.env

# NVIDIA API key for the symptom reader: build.nvidia.com → "Get API Key" (starts with nvapi-).
BAYMAX_API_KEY=

# Optional: a different model ID from build.nvidia.com, or another OpenAI-compatible endpoint.
# BAYMAX_LLM_MODEL=nvidia/nemotron-3.5-bolt-e4b
# BAYMAX_LLM_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Geoapify Places API key for the clinic finder: myprojects.geoapify.com (free, no card).
# Leave empty to use the public Overpass servers instead (slower, often busy).
GEOAPIFY_API_KEY=
