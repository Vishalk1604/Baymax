rules_version = '2';

// Every piece of app data lives under users/{uid}: the profile document plus
// its Checkups, Medication (with Reminder / Taken), and Appointments
// subcollections. A signed-in user can read and write only their own tree.
// Deploy with the real project later: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
