# ── Secrets — NEVER commit ─────────────────────────────────────────────────
# .env holds the NVIDIA and Geoapify API keys (read by lib/config/app_config.dart).
# Copy .env.example to .env and fill in your own key.
.env
.env.*
!.env.example

# Machine-specific SDK paths written by the Flutter tooling.
android/local.properties
android/key.properties
*.jks
*.keystore

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase Local Emulator Suite data (local test accounts and documents)
.emulator-data/
firebase-debug.log
firestore-debug.log
ui-debug.log
